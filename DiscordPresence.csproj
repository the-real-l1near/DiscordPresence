<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>

    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Application -->
    <AssemblyName>DiscordPresence</AssemblyName>
    <RootNamespace>DiscordPresence</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- Metadata -->
    <AssemblyTitle>Discord Presence</AssemblyTitle>
    <Product>Discord Presence</Product>
    <Description>
      Automatic Discord Rich Presence for supported desktop applications.
    </Description>

    <Company>Aurelia Team</Company>
    <Authors>l1near</Authors>
    <Copyright>Copyright © 2026 Aurelia Team</Copyright>

    <!-- Version -->
    <Version>1.3.2</Version>
    <AssemblyVersion>1.3.2.0</AssemblyVersion>
    <FileVersion>1.3.2.0</FileVersion>
    <InformationalVersion>1.3.2</InformationalVersion>

    <!-- Publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Runtime is installed on demand by the installer when missing. -->
    <SelfContained>false</SelfContained>

    <!-- Keep dependencies as separate files -->
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Avoid trimming compatibility issues -->
    <PublishTrimmed>false</PublishTrimmed>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Release -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="native\DiscordSocialBridge\build\Release\DiscordSocialBridge.dll"
          Link="DiscordSocialBridge.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />

    <None Include="native\sdk\bin\discord_partner_sdk.dll"
          Link="discord_partner_sdk.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keep the development-only icon packer out of the WinForms assembly. -->
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <!-- Generated PNG atlas is embedded directly in DiscordPresence.exe. -->
  <ItemGroup>
    <None Remove="embedded-icons.json" />
    <EmbeddedResource Include="embedded-icons.json"
                      LogicalName="DiscordPresence.EmbeddedIcons.json" />
  </ItemGroup>

  <!--
    Svg.Skia is used only by tools/IconPacker at build time.
    The published application no longer carries Svg.Skia/SkiaSharp.
  -->
  <Target
    Name="GenerateEmbeddedIcons"
    BeforeTargets="PrepareResources"
    Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildProjectDirectory)\Assets\Icons')">

    <Exec
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\GenerateEmbeddedIcons.ps1&quot;" />
  </Target>

</Project>